menu "ESP32-CAM Surveillance Firmware"

    config FIRMWARE_CAMERA_JPEG_QUALITY
        int "JPEG quality (0=highest, 63=lowest, 18=balanced)"
        range 0 63
        default 18
        help
            OV2640 JPEG quality factor. Lower = higher quality + larger frame.
            12 ≈ premium, 18 ≈ balanced (default), 25 ≈ compact for low bandwidth.

    config FIRMWARE_CAMERA_FRAME_SIZE
        int "Frame size enum (FRAMESIZE_QVGA=5, VGA=8, SVGA=9)"
        range 0 13
        default 5
        help
            See esp32-camera framesize_t. Low-energy default is QVGA (5).

    config FIRMWARE_STREAM_FPS
        int "Default stream framerate when backend sends stream.on"
        range 1 30
        default 5

    config FIRMWARE_STREAM_FPS_MIN
        int "Hard floor on stream fps"
        range 1 10
        default 1

    config FIRMWARE_WS_RECONNECT_INITIAL_MS
        int "Reconnect delay after the first failure (ms)"
        range 500 30000
        default 2000

    config FIRMWARE_WS_RECONNECT_CAP_MS
        int "Maximum reconnect delay after exponential growth (ms)"
        range 5000 300000
        default 30000

    config FIRMWARE_SOFT_RECOVERY_FAILS
        int "Consecutive reconnect failures before esp_restart()"
        range 5 200
        default 30

    config FIRMWARE_SOFT_RECOVERY_WINDOW_MIN
        int "Sliding window for counting soft-recovery failures (minutes)"
        range 1 60
        default 10

    config FIRMWARE_PROVISIONING_AP_STOP_ON_CONNECT
        bool "Power down the softAP once station mode joins a network"
        default y

    # FW-06 status LED (R-23). GPIO + active-LOW polarity per PRD §
    # FR-7 L222-232: AI-THINKER ESP32-CAM onboard LED is wired from
    # VCC → resistor → GPIO 4 → LED → GND, so driving the GPIO LOW
    # turns the LED ON (active-LOW). The 5 period constants encode
    # the half-period (in ms) the esp_timer toggles the level for
    # each state; full blink period = 2 × half-period.
    config FIRMWARE_LED_GPIO
        int "Status LED GPIO number (AI-THINKER onboard LED = GPIO 4)"
        range 0 39
        default 4
        help
            The AI-THINKER ESP32-CAM onboard LED is on GPIO 4 per PRD
            L222. Override this only for non-AI-THINKER boards.

    config FIRMWARE_LED_ACTIVE_LOW
        bool "Status LED is active-LOW (default for AI-THINKER onboard LED)"
        default y
        help
            AI-THINKER hardware: VCC → resistor → GPIO 4 → LED → GND.
            Driving the GPIO LOW sinks current and turns the LED ON.
            Disable for boards where LED is wired VCC-side to GPIO.

    config FIRMWARE_LED_PERIOD_WIFI_CONNECTING_MS
        int "WiFi-connecting blink period (ms; esp_timer period = half)"
        range 50 1000
        default 200
        help
            PRD § FR-7 L227: WiFi connecting = 200 ms blink.

    config FIRMWARE_LED_PERIOD_WS_CONNECTING_MS
        int "WS-connecting blink period (ms; esp_timer period = half)"
        range 50 1000
        default 100
        help
            PRD § FR-7 L228: WS connecting = 100 ms blink.

    config FIRMWARE_LED_PERIOD_IDLE_HEARTBEAT_MS
        int "Idle heartbeat period (ms; esp_timer period = half)"
        range 200 5000
        default 1000
        help
            PRD § FR-7 L229: idle (no stream) = 1 s heartbeat.

    config FIRMWARE_LED_PERIOD_BACKOFF_MS
        int "Reconnect-backoff blink period (ms; esp_timer period = half)"
        range 500 10000
        default 2000
        help
            PRD § FR-7 L231: reconnect backoff active = 2 s blink.

    config FIRMWARE_LED_PERIOD_RECOVERY_MS
        int "Soft-recovery rapid-blink period (ms; esp_timer period = half)"
        range 50 1000
        default 100
        help
            PRD § FR-7 L232: 5 Hz rapid blink during the 3 s sustained
            recovery window before reboot. 100 ms = 5 Hz.

    config FIRMWARE_LED_RECOVERY_DURATION_MS
        int "Soft-recovery sustained duration before recovery-cb fires (ms)"
        range 500 10000
        default 3000
        help
            PRD § FR-7 L232: rapid blink sustained for 3 s before reboot.
            The one-shot esp_timer fires the recovery-complete cb at
            this elapsed time.

    # FW-07 boot button (R-03 measurement half + R-24 runtime
    # factory reset). Reads GPIO 0 (AI-THINKER ESP32-CAM onboard
    # PRG button, active-LOW per PRD § FR-7 L234-238). The driver
    # owns the BOOT_TIME→RUNTIME phase machine + debounce + the
    # 500 ms strap-grace window that absorbs the ROM bootloader's
    # GPIO-0 transient. Separate pin from the FW-06 status LED
    # (GPIO 4, OUTPUT) — see the FW-06 charter amendment at
    # commits 048a3cf + d0942e5.
    config FIRMWARE_BOOT_BUTTON
        bool "Enable the boot-button driver (FW-07)"
        default y
        help
            When disabled the button component compiles to a no-op
            TU and boot_button_pressed_at_boot() resolves only the
            weak default in boot_button_stub.c. Enable for normal
            provisioning + runtime factory-reset support.

if FIRMWARE_BOOT_BUTTON

    config FIRMWARE_BOOT_BUTTON_GPIO
        int "Boot button GPIO number (AI-THINKER ESP32-CAM PRG button = GPIO 0)"
        range 0 39
        default 0
        help
            The AI-THINKER ESP32-CAM onboard PRG button is on GPIO 0
            per PRD § FR-7 L234. Override only for non-AI-THINKER
            boards. GPIO 0 is the strapping pin — the driver applies
            a FIRMWARE_BOOT_BUTTON_STRAP_GRACE_MS grace window
            after button_init() to absorb the ROM bootloader
            transient.

    config FIRMWARE_BOOT_BUTTON_TAP_MAX_MS
        int "Press duration threshold below which a tap is ignored (ms)"
        range 50 500
        default 100
        help
            Presses shorter than this are treated as tap-jitter and
            discarded by the FW-07.1 tap-ignore state machine. The
            boundary is tested at 99/100/101 ms (acceptance +
            rejection on either side).

    config FIRMWARE_BOOT_BUTTON_BOOT_LONGPRESS_MS
        int "Minimum continuous press during BOOT_TIME phase to assert provisioning signal (ms)"
        range 1000 30000
        default 3000
        help
            FW-07.2: a held press of at least this duration during
            the BOOT_TIME phase sets boot_button_pressed_at_boot()
            to true. Consumed at boot.c:124 (FW-03.3). Default 3 s
            matches PRD § FR-7 L237.

    config FIRMWARE_BOOT_BUTTON_RUNTIME_LONGPRESS_MS
        int "Minimum continuous press during RUNTIME phase to trigger factory reset (ms)"
        range 5000 60000
        default 10000
        help
            FW-07.3: a held press of at least this duration during
            the RUNTIME phase fires the registered callback exactly
            once (production wires config_factory_reset() +
            esp_restart()). The DEBOUNCE_MS * 4 (= 80 ms) cooldown
            prevents double-fire while the user keeps holding.
            Default 10 s matches PRD § FR-7 L237.

    config FIRMWARE_BOOT_BUTTON_DEBOUNCE_MS
        int "Minimum time between consecutive edges to debounce (ms)"
        range 5 100
        default 20
        help
            Edges that arrive within this window of the previous
            edge are dropped (FW-07.1). Smallest + simplest
            debounce strategy (matches PRD "press jitter" wording).
            The bite-proof (-DBUTTON_TEST_STUB_DISABLE_DEBOUNCE=1)
            short-circuits this filter so the guard tripwire can
            verify it is load-bearing.

    config FIRMWARE_BOOT_BUTTON_STRAP_GRACE_MS
        int "Grace window after button_init() during which GPIO reads are ignored (ms)"
        range 100 2000
        default 500
        help
            GPIO 0 is the strapping pin; the ROM bootloader holds
            it LOW for ~100 ms after reset. Without a grace window,
            a "long press" would be falsely detected from the very
            first poll. The driver enters BOOT_TIME only after this
            window elapses. Default 500 ms is well above the
            transient envelope.

    config FIRMWARE_BOOT_BUTTON_BOOT_TIME_WINDOW_MS
        int "BOOT_TIME phase duration after strap grace ends (ms)"
        range 1000 30000
        default 5000
        help
            FW-07.2: the state machine is in BOOT_TIME from
            (button_init + STRAP_GRACE_MS) to (button_init +
            STRAP_GRACE_MS + BOOT_TIME_WINDOW_MS). After this
            window the phase transitions to RUNTIME and the
            boot-time latch becomes sticky (Phase D wires the
            runtime factory-reset cb). Default 5 s gives the
            user enough slack to hold for ≥ BOOT_LONGPRESS_MS
            (3 s default) and still see the rising edge inside
            BOOT_TIME; longer presses (10 s, 30 s, etc.) cross
            into RUNTIME while the latch is already sticky-true.

endif  # FIRMWARE_BOOT_BUTTON

endmenu