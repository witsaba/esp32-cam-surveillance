# sdkconfig.defaults — ESP-IDF v5.5.3, AI-Thinker ESP32-CAM, 4 MB flash.
#
# This file is generated by `idf.py save-defconfig` after a menuconfig
# session (per PRD § Build prerequisites step 5). The values here are
# the non-default overrides that must apply to every build.
#
# Bootloader / flasher
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# Partition table — custom so we can declare the 24 KB NVS partition
# used by FW-02 and the future FW-20 `camera_cfg` namespace.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# PSRAM — required for AI-Thinker ESP32-CAM (4 MB PSRAM module).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# WebSocket client — dynamic buffer for streaming payloads.
CONFIG_ESP_WS_CLIENT_ENABLE_DYNAMIC_BUFFER=y

# FW-16 — esp_http_server WebSocket support (device-as-server:
# the /cams endpoint needs .is_websocket + httpd_ws_* APIs).
CONFIG_HTTPD_WS_SUPPORT=y

# Project tunables (mirrored from Kconfig.projbuild defaults).
CONFIG_FIRMWARE_CAMERA_JPEG_QUALITY=18
CONFIG_FIRMWARE_CAMERA_FRAME_SIZE=5
CONFIG_FIRMWARE_STREAM_FPS=5
CONFIG_FIRMWARE_STREAM_FPS_MIN=1
CONFIG_FIRMWARE_STREAM_FPS_MAX=15
CONFIG_FIRMWARE_WS_RECONNECT_INITIAL_MS=2000
CONFIG_FIRMWARE_WS_RECONNECT_CAP_MS=30000
CONFIG_FIRMWARE_SOFT_RECOVERY_FAILS=30
CONFIG_FIRMWARE_SOFT_RECOVERY_WINDOW_MIN=10
CONFIG_FIRMWARE_PROVISIONING_AP_STOP_ON_CONNECT=y
# FW-08 — wifi station backoff schedule (charter L742-748).
CONFIG_FIRMWARE_WIFI_BACKOFF_INITIAL_MS=2000
CONFIG_FIRMWARE_WIFI_BACKOFF_CAP_MS=30000
CONFIG_FIRMWARE_WIFI_BACKOFF_MAX_FAILS=-1

# Compiler warnings — strict, treat-as-error for clean CI.
CONFIG_COMPILER_WARN_WRITE_STRINGS=y

# FW-13 — identity component (mirrors components/identity/Kconfig).
CONFIG_FIRMWARE_IDENTITY_NAME_MAX_LEN=32
CONFIG_FIRMWARE_IDENTITY_DESCRIPTION_MAX_LEN=64

# FW-16 — ws component, server mode (mirrors components/ws/Kconfig).
CONFIG_FIRMWARE_WS_PATH="/cams"
CONFIG_FIRMWARE_WS_BUFFER_SIZE=16384
CONFIG_FIRMWARE_WS_STATUS_PERIOD_MS=30000

# AI-Thinker flash LED (GPIO 4) is active-HIGH (NPN transistor driver).
CONFIG_FIRMWARE_LED_ACTIVE_LOW=n

